# ---------------------------------------------------------------------------
# EVgoSmart environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# Only NEXT_PUBLIC_* values are allowed in the browser bundle.
# ---------------------------------------------------------------------------

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Demo guard. Must be "true" for seed/reset scripts.
DEMO_MODE=false

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS. Never import this into a client component.
SUPABASE_SECRET_KEY=

# Postgres (Project Settings -> Database)
# Runtime: transaction pooler, port 6543.
DATABASE_URL=
# Migrations only: direct connection, port 5432.
DIRECT_DATABASE_URL=

# Google Maps
# Browser key: restricted by HTTP referrer to localhost + deployed domains.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Server key: Directions / Geocoding / Distance Matrix only. Secret.
GOOGLE_MAPS_SERVER_API_KEY=

# Razorpay (test mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo allowlist (project refs allowed for seed/reset scripts)
SUPABASE_DEMO_PROJECT_REFS=

# Resend
RESEND_API_KEY=
EMAIL_FROM="EVgoSmart <noreply@demo.evgosmart.test>"

# Sentry (optional, server + client)
SENTRY_DSN=
